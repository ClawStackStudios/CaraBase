{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5454 --host 127.0.0.1 --strictPort",
    "dev:server": "PORT=5353 tsx watch --exclude data server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "scuttle": "npm run scuttle:dev-start",
    "scuttle:prod": "npm run scuttle:prod-start",
    "scuttle:dev-start": "npm run dev:server & npm run dev",
    "scuttle:prod-start": "npm run build && (NODE_ENV=production PORT=5353 tsx server.ts & vite preview --port 5454 --host)",
    "scuttle:reset": "npm run scuttle:stop && rm -rf dist && rm -rf data && mkdir -p data",
    "scuttle:reset-db": "rm -f data/carabase.sqlite && echo '✅ Database reset. Restart server to recreate schema.'",
    "scuttle:stop": "fuser -k -15 5454/tcp 5353/tcp || true"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@vitejs/plugin-react": "^5.0.4",
    "better-sqlite3-multiple-ciphers": "^12.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "js-sha256": "^0.11.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.1.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.15.1",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "tailwind-merge": "^3.6.0",
    "uuid": "^14.0.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
