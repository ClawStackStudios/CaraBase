{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5454 --host 127.0.0.1 --strictPort",
    "dev:server": "PORT=5353 tsx watch --exclude data server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "test": "node tests/suite.cjs",
    "scuttle": "npm run scuttle:dev-start",
    "scuttle:prod": "npm run scuttle:prod-start",
    "scuttle:dev-start": "npm run dev:server & npm run dev",
    "scuttle:prod-start": "npm run build && (NODE_ENV=production PORT=5353 tsx server.ts & vite preview --port 5454 --host)",
    "scuttle:reset": "npm run scuttle:stop && rm -rf dist && rm -rf data && mkdir -p data",
    "scuttle:reset-db": "rm -f data/carabase.sqlite data/carabase.sqlite-wal data/carabase.sqlite-shm && echo '✅ Database reset. Restart server to recreate schema.'",
    "scuttle:stop": "fuser -k -15 5454/tcp 5353/tcp || true"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/better-sqlite3": "7.6.13",
    "@types/cookie-parser": "1.4.10",
    "@vitejs/plugin-react": "5.0.4",
    "better-sqlite3-multiple-ciphers": "12.9.0",
    "clsx": "2.1.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "17.2.3",
    "eventsource": "3.0.5",
    "express": "4.21.2",
    "helmet": "8.2.0",
    "js-sha256": "0.11.1",
    "lucide-react": "0.479.0",
    "motion": "12.4.10",
    "multer": "1.4.5-lts.1",
    "node-cron": "3.0.3",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.3.0",
    "sqlite": "5.1.1",
    "sqlite3": "5.1.7",
    "tailwind-merge": "3.0.2",
    "uuid": "11.1.0",
    "vite": "6.2.1"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "4.17.21",
    "@types/multer": "2.1.13",
    "@types/node": "22.13.10",
    "@types/node-cron": "3.0.11",
    "@types/sqlite3": "3.1.11",
    "@types/uuid": "10.0.0",
    "autoprefixer": "10.4.20",
    "esbuild": "0.25.1",
    "tailwindcss": "4.1.14",
    "tsx": "4.19.3",
    "typescript": "5.8.2",
    "vite": "6.2.1"
  }
}
