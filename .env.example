# ==========================================
# CaraBase Environment Configuration
# ==========================================

# ------------------------------------------
# 1. Security & Authentication (Required)
# ------------------------------------------

# DB_ENCRYPTION_KEY: Required in production! This encrypts the SQLite database at rest.
# To generate a secure hex key, run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Example: DB_ENCRYPTION_KEY="your_64_character_hex_string"
DB_ENCRYPTION_KEY=""

# ADMIN_TOKEN: Optional. Enables the SuperAdmin dashboard at /admin.
# If not set, the admin panel returns 503 and is completely inaccessible.
# Set to a strong, random string. The client SHA-256 hashes it before sending.
# To generate a strong token, run: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# ADMIN_TOKEN="MY_ADMIN_TOKEN"

# ------------------------------------------
# 2. Server & Networking
# ------------------------------------------

# NODE_ENV: Sets the environment mode (production or development).
# NODE_ENV="production"

# PORT: The port the CaraBase server listens on (default: 5353).
# PORT=5353

# HOST: The host the CaraBase server binds to (default: 0.0.0.0).
# HOST="0.0.0.0"

# ENFORCE_HTTPS: Set to "true" to mark admin session cookies as Secure.
# Required when running behind HTTPS in production.
# ENFORCE_HTTPS="true"

# CLOUDFLARE_TUNNEL_URL: Optional. If using Cloudflare Tunnels, set this to the public URL.
# This enables public file sharing URLs and sets the default CORS origin in production.
# CLOUDFLARE_TUNNEL_URL="https://carabase.yourdomain.com"

# CORS_ORIGINS: Optional. Explicitly whitelist domains that can access the API.
# Comma separated. Defaults to CLOUDFLARE_TUNNEL_URL if omitted.
# CORS_ORIGINS="https://carabase.yourdomain.com,https://your-frontend-app.com"

# ------------------------------------------
# 3. Storage & Data
# ------------------------------------------

# DATA_DIR: Directory where the SQLite database and files are stored.
# DATA_DIR="./data"

# MAX_UPLOAD_SIZE_MB: Maximum allowed file upload size in megabytes.
# MAX_UPLOAD_SIZE_MB=50

# ------------------------------------------
# 4. Auth Tokens
# ------------------------------------------

# TOKEN_TTL_DEFAULT: Default time-to-live for API tokens.
# TOKEN_TTL_DEFAULT="1d"

# ------------------------------------------
# 5. Backups
# ------------------------------------------

# BACKUP_DIR: Directory where database backups are stored (default: data/backups).
# BACKUP_DIR="./data/backups"

# BACKUP_RETENTION_COUNT: Number of automated backups to retain.
# BACKUP_RETENTION_COUNT=5
